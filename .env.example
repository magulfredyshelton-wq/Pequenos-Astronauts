ASTRO_HOST=127.0.0.1
ASTRO_PORT=8000
ASTRO_PUBLIC_URL=http://127.0.0.1:8000
ASTRO_DATABASE_URL=host=127.0.0.1 port=5432 dbname=astronautas user=astronautas password=trocar_esta_senha
ASTRO_CEREBRO=auto
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
ASTRO_CONVERSA_LIVRE=0
# Dados reais de EVA da NASA (descarregados no arranque e guardados em backend/data/eva_cache.json)
ASTRO_EVA=1
# ASTRO_EVA_TTL_DIAS=7
# ASTRO_EVA_URLS=

# Ciência da missão com dados reais da NASA (APOD, DONKI, RadLab, OSDR). Ver app/nasa.py.
ASTRO_NASA=1
# Chave gratuita de https://api.nasa.gov (sem chave usa DEMO_KEY, com limites baixos).
# NASA_API_KEY=
# ASTRO_NASA_TTL_HORAS=6
# ASTRO_NASA_CACHE=backend/data/nasa_cache.json
# 1 = um alerta solar real do DONKI agrava o incidente "radiacao"/"abrigo_marte".
# Desligado por omissão para as partidas continuarem determinísticas.
ASTRO_NASA_JOGO=0
